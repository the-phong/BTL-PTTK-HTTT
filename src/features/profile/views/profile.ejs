<%- include('../../../views/partials/header', { title }) %>
<section class="section-head">
  <div>
    <span class="eyebrow">TÀI KHOẢN CỦA BẠN</span>
    <h1>Thông tin <em>cá nhân.</em></h1>
    <p>Mã khách hàng: <strong><%= profile.MaKhachHang %></strong></p>
  </div>
</section>
<div class="profile-card form-card wide">
  <% if (success) { %><div class="notice success"><%= success %></div><% } %>
  <% if (errors.length) { %>
    <div class="notice error"><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/thong-tin-ca-nhan">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-grid">
      <label>Họ và tên
        <input name="name" required minlength="2" maxlength="120" value="<%= profile.name || profile.HoTen || '' %>" />
      </label>
      <label>Ngày sinh
        <input name="birth" type="date" required value="<%= profile.birth || profile.NgaySinh || '' %>" />
      </label>
      <label>Số điện thoại
        <input name="phone" required maxlength="20" value="<%= profile.phone || profile.SoDienThoai || '' %>" />
      </label>
      <label>Email
        <input name="email" type="email" required maxlength="190" value="<%= profile.email || profile.Email || '' %>" />
      </label>
      <label class="span-two">Địa chỉ
        <input name="address" required maxlength="255" value="<%= profile.address || profile.DiaChi || '' %>" />
      </label>
    </div>
    <button class="button primary">Lưu thay đổi <span>→</span></button>
  </form>
</div>
<%- include('../../../views/partials/footer') %>
