<%- include('../../../views/partials/header', { title }) %>
<section class="section-head">
  <div>
    <span class="eyebrow">THÔNG TIN XE</span>
    <h1><%= car.TenXe %></h1>
    <p><%= car.MoTa || 'Xe sẵn sàng cho chuyến đi của bạn.' %></p>
  </div>
</section>
<div class="car-visual tone-0">
  <img src="<%= car.Anh || '/images/vehicles/default-car.svg' %>" alt="<%= car.TenXe %>" />
</div>
<div class="table-wrap">
  <table>
    <tbody>
      <tr><th>Mã xe</th><td><%= car.MaXeHienThi %></td></tr>
      <tr><th>Biển số</th><td><%= car.BienSo %></td></tr>
      <tr><th>Hãng xe</th><td><%= car.HangXe %></td></tr>
      <tr><th>Loại xe</th><td><%= car.LoaiXe %></td></tr>
      <tr><th>Số chỗ</th><td><%= car.SoCho %></td></tr>
      <tr><th>Năm sản xuất</th><td><%= car.NamSanXuat %></td></tr>
      <tr><th>Hộp số</th><td><%= car.HopSo || 'Chưa cập nhật' %></td></tr>
      <tr><th>Nhiên liệu</th><td><%= car.NhienLieu || 'Chưa cập nhật' %></td></tr>
      <tr><th>Đơn giá / giờ</th><td><%= Number(car.DonGiaGio).toLocaleString('vi-VN') %> đ</td></tr>
      <tr><th>Thời lượng thuê</th><td><%= hours %> giờ</td></tr>
      <tr><th>Chi phí dự kiến</th><td><%= (Number(car.DonGiaGio) * hours).toLocaleString('vi-VN') %> đ</td></tr>
      <tr><th>Nhận xe</th><td><%= period.start.replace('T', ' ') %></td></tr>
      <tr><th>Trả xe</th><td><%= period.end.replace('T', ' ') %></td></tr>
      <tr><th>Trạng thái</th><td><%= car.KhaDung ? 'Còn trống trong khoảng thuê' : 'Không khả dụng trong khoảng thuê' %></td></tr>
    </tbody>
  </table>
</div>
<% if (car.KhaDung) { %>
<form method="post" action="/dat-xe/chon">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="carId" value="<%= car.MaXe %>" />
  <button class="button primary">Chọn xe <span>＋</span></button>
</form>
<% } else { %>
<div class="notice error">Xe không còn khả dụng trong khoảng thời gian đã chọn. Vui lòng tìm xe khác.</div>
<% } %>
<p><a href="/dat-xe/tim">← Quay lại danh sách tìm kiếm</a></p>
<%- include('../../../views/partials/footer') %>
