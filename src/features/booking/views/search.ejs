<%- include('../../../views/partials/header', { title }) %>

<section class="section-head">
  <div>
    <span class="eyebrow">CHỌN XE PHÙ HỢP</span>
    <h1>Tìm xe <em>cho chuyến đi.</em></h1>
    <p>Chọn thời gian và tiêu chí, chúng tôi sẽ tìm xe còn trống.</p>
  </div>
  <span class="step-pill">01 — TÌM KIẾM</span>
</section>

<form class="search-panel" method="get" action="/dat-xe/tim">
  <label>
    Loại xe
    <select name="type">
      <option value="">Tất cả loại xe</option>
      <% ['SUV', 'Sedan', 'MPV', 'Hatchback', 'Bán tải'].forEach((type) => { %>
      <option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>>
        <%= type %>
      </option>
      <% }) %>
    </select>
  </label>

  <label>
    Số chỗ
    <select name="seats">
      <option value="">Bất kỳ</option>
      <% [4, 5, 7, 9, 16].forEach((seats) => { %>
      <option
        value="<%= seats %>"
        <%= String(filters.seats) === String(seats) ? 'selected' : '' %>
      >
        <%= seats %> chỗ
      </option>
      <% }) %>
    </select>
  </label>

  <label>
    Nhận xe
    <input
      name="start"
      type="datetime-local"
      required
      value="<%= filters.start %>"
      step="3600"
    />
  </label>

  <label>
    Trả xe
    <input
      name="end"
      type="datetime-local"
      required
      value="<%= filters.end %>"
      step="3600"
    />
  </label>

  <button class="button primary">Tìm xe <span>→</span></button>
</form>

<% if (error) { %>
    <div class="notice error"><%= error %></div>
<% } %>
<% if (notice) { %>
  <div class="notice"><%= notice %></div>
<% } %>

<div class="results-title">
  <h2>Xe phù hợp</h2>
  <span><%= pagination ? pagination.total : 0 %> kết quả</span>
</div>

<% if (!filters.start) { %>
<div class="empty-state">
  Nhập thời gian nhận và trả xe để xem xe đang khả dụng.
</div>
<% } else if (!cars.length) { %>
<div class="empty-state">
  Chưa tìm thấy xe phù hợp. Hãy thử thay đổi tiêu chí hoặc thời gian.
</div>
<% } %>

<div class="car-grid">
  <% cars.forEach((car, index) => { %>
  <article class="car-card">
    <div class="car-visual tone-<%= index % 4 %>">
      <span><%= car.LoaiXe %> · <%= car.SoCho %> CHỖ</span>
      <img src="<%= car.Anh || '/images/vehicles/default-car.svg' %>" alt="<%= car.TenXe %>" />
      <small><%= car.MaXeHienThi %></small>
    </div>

    <div class="car-info">
      <div class="car-title">
        <div>
          <h3><%= car.TenXe %></h3>
          <span>
            <%= car.HangXe %> · <%= car.NamSanXuat %> · <%= car.BienSo %>
          </span>
        </div>
        <strong>
          <%= Number(car.DonGiaGio).toLocaleString('vi-VN') %>
          <small>đ / giờ</small>
        </strong>
      </div>

      <p>
        <%= car.MoTa || 'Xe được bảo dưỡng định kỳ, sẵn sàng cho hành trình của bạn.' %>
      </p>

      <form method="post" action="/dat-xe/chon">
        <a href="/dat-xe/xe/<%= car.MaXe %>">Xem chi tiết xe →</a>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="carId" value="<%= car.MaXe %>" />
        <button class="button outline full">Chọn xe <span>＋</span></button>
      </form>
    </div>
  </article>
  <% }) %>
</div>

<% if (pagination && pagination.totalPages > 1) { %>
<nav class="pagination" aria-label="Phân trang xe">
  <% if (pagination.page > 1) { %>
  <a href="/dat-xe/tim?<%= pagination.base %>&page=<%= pagination.page - 1 %>">← Trước</a>
  <% } %>
  <span>Trang <%= pagination.page %> / <%= pagination.totalPages %></span>
  <% if (pagination.page < pagination.totalPages) { %>
  <a href="/dat-xe/tim?<%= pagination.base %>&page=<%= pagination.page + 1 %>">Tiếp →</a>
  <% } %>
</nav>
<% } %>

<%- include('../../../views/partials/footer') %>
